version: "3.8"

services:
  minio:
    image: minio/minio:latest
    container_name: wall-minio
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: minioadmin
      MINIO_ROOT_PASSWORD: minioadmin123
    ports:
      - "39000:9000"
      - "39001:9001"
    volumes:
      - ./data/minio:/data
    restart: unless-stopped

  labelstudio:
    image: heartexlabs/label-studio:latest
    container_name: wall-labelstudio
    depends_on:
      - minio
    environment:


      #LABEL_STUDIO_HOST: "http://192.168.0.116:7080"
      LABEL_STUDIO_HOST: "http://frpclient04.xhyonline.com:8524"
      LABEL_STUDIO_PORT: "8080"

      # 禁止自动注册功能
      LABEL_STUDIO_DISABLE_SIGNUP_WITHOUT_LINK: "true"

      # 开启跨域屏蔽
      CORS_ALLOW_ALL_ORIGINS: "false"

      # 白名单：包含外网域名、内网IP和本机
      CORS_ALLOWED_ORIGINS: "http://frpclient04.xhyonline.com:8524,http://192.168.0.116:7080,http://localhost:7080"
    ports:
      - "7080:8080"
    volumes:
      - ./data/label-studio:/label-studio/data
    restart: unless-stopped
