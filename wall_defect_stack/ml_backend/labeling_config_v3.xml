<!--
Label Studio 标注配置 - 墙体缺陷检测 V3.0
基于 model_3.py 的 5 大分类体系设计

分类体系：
1. 商品/包裹实拍图
2. 购物app截图 (含子标签)
3. 制式图片 (含子标签)
4. 环境实拍图 (含4维属性)
5. 其他
-->
<View>
  <!-- ==================== 图像显示区域 ==================== -->
  <Image name="image" value="$image" zoom="true" width="100%"/>

  <!-- ==================== 一级分类 (必填) ==================== -->
  <Header value="📋 一级分类 (必选)"/>
  <Choices name="primary_category" toName="image" required="true">
    <Choice value="商品/包裹实拍图"/>
    <Choice value="购物app截图"/>
    <Choice value="制式图片"/>
    <Choice value="环境实拍图"/>
    <Choice value="其他"/>
  </Choices>

  <!-- ==================== 购物app截图子标签 ==================== -->
  <Header value="🛒 购物app截图 - 页面类型"/>
  <Choices name="app_sub_label" toName="image" required="false"
           visibleWhen="region-selected"
           whenname="primary_category"
           whenvalue="购物app截图">
    <Choice value="商品头图"/>
    <Choice value="商品详情页"/>
    <Choice value="规格分类"/>
    <Choice value="订单详情页"/>
    <Choice value="购物车页"/>
    <Choice value="评论区"/>
    <Choice value="其他"/>
  </Choices>

  <!-- ==================== 制式图片子标签 ==================== -->
  <Header value="📐 制式图片 - 类型"/>
  <Choices name="standard_sub_label" toName="image" required="false"
           visibleWhen="region-selected"
           whenname="primary_category"
           whenvalue="制式图片">
    <Choice value="户型图"/>
    <Choice value="装修图"/>
    <Choice value="其他"/>
  </Choices>

  <!-- ==================== 环境实拍图 - 四维属性 ==================== -->
  <Header value="🏠 环境实拍图 - 详细属性"
          visibleWhen="region-selected"
          whenname="primary_category"
          whenvalue="环境实拍图"/>

  <!-- 维度1: 环境 (Environment) -->
  <Header value="1️⃣ 环境位置"
          visibleWhen="region-selected"
          whenname="primary_category"
          whenvalue="环境实拍图"/>
  <Choices name="environment" toName="image" required="false"
           visibleWhen="region-selected"
           whenname="primary_category"
           whenvalue="环境实拍图">
    <Choice value="阳台"/>
    <Choice value="厨房"/>
    <Choice value="卫生间"/>
    <Choice value="客厅"/>
    <Choice value="卧室"/>
    <Choice value="室外"/>
    <Choice value="其他"/>
  </Choices>

  <!-- 维度2: 具体位置 (Location) -->
  <Header value="2️⃣ 具体位置"
          visibleWhen="region-selected"
          whenname="primary_category"
          whenvalue="环境实拍图"/>
  <Choices name="location" toName="image" required="false"
           visibleWhen="region-selected"
           whenname="primary_category"
           whenvalue="环境实拍图">
    <Choice value="墙面"/>
    <Choice value="地面"/>
    <Choice value="天花板"/>
    <Choice value="屋顶"/>
    <Choice value="门/窗框"/>
    <Choice value="水池"/>
    <Choice value="马桶"/>
    <Choice value="阴阳角"/>
    <Choice value="柜体"/>
    <Choice value="踢脚线"/>
    <Choice value="瓷砖缝隙"/>
    <Choice value="其他"/>
  </Choices>

  <!-- 维度3: 材质 (Material) -->
  <Header value="3️⃣ 表面材质"
          visibleWhen="region-selected"
          whenname="primary_category"
          whenvalue="环境实拍图"/>
  <Choices name="material" toName="image" required="false"
           visibleWhen="region-selected"
           whenname="primary_category"
           whenvalue="环境实拍图">
    <Choice value="腻子层"/>
    <Choice value="乳胶漆涂层"/>
    <Choice value="水泥/混凝土"/>
    <Choice value="瓷砖"/>
    <Choice value="木材"/>
    <Choice value="金属"/>
    <Choice value="其他"/>
  </Choices>

  <!-- 维度4: 问题类型 (Problem Type) - 最重要的分类 -->
  <Header value="4️⃣ 问题类型 (核心诊断)"
          visibleWhen="region-selected"
          whenname="primary_category"
          whenvalue="环境实拍图"/>
  <Choices name="problem_type" toName="image" required="false"
           visibleWhen="region-selected"
           whenname="primary_category"
           whenvalue="环境实拍图">
    <Choice value="毛坯/腻子批刮中"/>
    <Choice value="完好旧墙面"/>
    <Choice value="污渍&涂鸦"/>
    <Choice value="掉皮&起皮"/>
    <Choice value="开裂&孔洞"/>
    <Choice value="露出基层"/>
    <Choice value="空鼓&翘边"/>
    <Choice value="发霉&返碱"/>
    <Choice value="缝隙脱落"/>
    <Choice value="无明显缺陷"/>
    <Choice value="无法识别"/>
  </Choices>

  <!-- ==================== 商品信息提取 (可选) ==================== -->
  <Header value="🛍️ 商品信息 (可选，用于包含商品的图片)"/>
  <Taxonomy name="products_taxonomy" toName="image" required="false">
    <Choice value="包含商品信息">
      <Choice value="商品名称"/>
      <Choice value="价格"/>
      <Choice value="规格/SKU"/>
      <Choice value="数量"/>
    </Choice>
  </Taxonomy>

  <!-- ==================== 备注区域 ==================== -->
  <Header value="📝 备注信息"/>
  <TextArea name="notes" toName="image" required="false"
            placeholder="请输入任何额外的备注信息..."/>

  <!-- ==================== AI 推理结果显示 (只读) ==================== -->
  <Header value="🤖 AI 推理结果 (仅供参考)"/>
  <TextArea name="ai_reasoning" toName="image" required="false"
            editable="false"
            placeholder="AI 模型的推理过程将显示在这里..."/>
</View>
